<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Azure / classic Windows hosting configuration.
  - Sets MIME types for SPA assets (SVG, Web Manifest, etc.)
  - Sends proper cache headers for static files.
  - GitHub Pages ignores this file entirely, so it is safe to ship.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".cur" />
      <mimeMap fileExtension=".cur" mimeType="application/octet-stream" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public, max-age=3600" />
      </customHeaders>
    </httpProtocol>
    <!-- Let the static SPA server handle requests; no rewrite needed for a single page. -->
    <defaultDocument>
      <files>
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
